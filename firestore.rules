rules_version = '2';

// Questionários: qualquer pessoa autenticada lê (para entrar na sala pelo código);
// só o dono escreve e apaga.
// Gabarito: só o dono lê — é o que impede um jogador de ver a resposta certa.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function dono() {
      return autenticado() && request.auth.uid == resource.data.donoUid;
    }

    match /quizzes/{quizId} {
      allow read: if autenticado();
      allow create: if autenticado() && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if dono();

      match /perguntas/{perguntaId} {
        allow read: if autenticado();
        allow write: if autenticado() && dono();
      }
    }

    match /gabaritos/{perguntaId} {
      allow read: if autenticado() && request.auth.uid == resource.data.donoUid;
      allow create: if autenticado() && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if autenticado() && request.auth.uid == resource.data.donoUid;
    }
  }
}
