rules_version = '2';

// Imagens das perguntas: leitura pública (a sala precisa exibir), escrita só na pasta do dono.
service firebase.storage {
  match /b/{bucket}/o {
    match /quiz/{uid}/{resto=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
