# Firebase — usado APENAS para autenticacao (e-mail/senha e Google).
# Painel: https://console.firebase.google.com -> Configuracoes do projeto -> Seus apps -> Web
PUBLIC_FIREBASE_API_KEY=cole-a-chave-web-aqui
PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Postgres (Neon) — persistencia de questionarios, perguntas e gabaritos.
# A API valida o idToken do Firebase e grava aqui pelo Drizzle.
DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require
# Endpoint direto (sem pooler): usado pelos scripts db:push / db:migrate / db:studio.
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require
# Endpoint com pooler (-pooler no host): para deploy serverless.
DATABASE_URL_POOLED=postgresql://usuario:senha@ep-xxx-pooler.neon.tech/neondb?sslmode=require

# Cloudinary — imagens das perguntas (upload assinado em POST /api/upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
