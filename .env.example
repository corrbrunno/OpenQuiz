# Firebase — configuracao publica do cliente (estes valores vao para o navegador).
# Painel: https://console.firebase.google.com -> Configuracoes do projeto -> Seus apps -> Web
PUBLIC_FIREBASE_API_KEY=cole-a-chave-web-aqui
PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Postgres (Drizzle) — usado apenas pelos scripts db:push / db:migrate / db:studio.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
